<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Страница пакета основателя: что получает купивший, сколько мест осталось, частые вопросы.

      Одна строка на сервер (`id = 'main'`), а не таблица разделов: страницу правит один
      администратор целиком и сохраняет целиком, и выбирать из неё по частям некому. Текст
      лежит JSON строкой (`content`) сразу на двух языках — его читает экран, а не правило
      игры, и состав разделов меняется правкой, а не миграцией.

      Живёт в источнике истории, рядом с учётными записями: это про сервер, а не про партию.
      Пока строки нет, сервер отдаёт страницу по умолчанию из `founders/default-page.json`.
    -->
    <changeSet id="100-founder-page" author="sddnw">
        <createTable tableName="founder_page">
            <column name="id" type="varchar(16)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="content" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="uuid"/>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
