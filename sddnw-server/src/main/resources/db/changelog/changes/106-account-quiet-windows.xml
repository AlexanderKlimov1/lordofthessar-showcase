<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Окна, которые открываются сами, — настройкой (field-backlog, пункт 164). quiet_windows:
        JSON-список ключей окон, которые НЕ открываются сами (разведанная система, наука после
        прорыва, сцены). Пусто — открываются все, как и было: для новичка это и есть обучение.
    -->
    <changeSet id="106-account-quiet-windows" author="sddnw">
        <addColumn tableName="account">
            <column name="quiet_windows" type="varchar(512)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
