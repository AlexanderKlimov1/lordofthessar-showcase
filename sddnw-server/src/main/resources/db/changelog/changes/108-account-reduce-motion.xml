<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Меньше движения (field-backlog, пункт 170). reduce_motion: да, нет или пусто — «как в
        системе» (prefers-reduced-motion). Пусто у всех — как и было.
    -->
    <changeSet id="108-account-reduce-motion" author="sddnw">
        <addColumn tableName="account">
            <column name="reduce_motion" type="boolean"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
