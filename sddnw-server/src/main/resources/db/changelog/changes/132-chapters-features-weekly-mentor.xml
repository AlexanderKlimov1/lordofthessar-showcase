<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Главы партии (field-backlog, пункт 54): глава у каждой империи своя и идёт только вперёд —
        её номер помнит строка игрока, иначе смену главы не с чем сравнить.
        Наставник (пункт 184): ученик сам называет, кому показать свою империю.
    -->
    <changeSet id="132-player-chapter-mentor" author="sddnw">
        <addColumn tableName="player">
            <column name="chapter" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="mentor_player_id" type="uuid"/>
        </addColumn>
    </changeSet>

    <!--
        Особенность галактики (пункт 94), неделя галактики недели (пункт 146) и союзники-победители
        (пункт 145): победитель партии по-прежнему один полем winner_player_id, а разделившие с ним
        победу союзом — списком рядом.
    -->
    <changeSet id="132-game-feature-weekly-allies" author="sddnw">
        <addColumn tableName="game">
            <column name="galaxy_feature" type="varchar(16)"/>
            <column name="weekly_week" type="int"/>
            <column name="co_winners" type="varchar(512)"/>
        </addColumn>
    </changeSet>

    <!-- Новые узоры по ходу партии (пункт 93): ход первой встречи с механикой. -->
    <changeSet id="132-empire-activity-first-turn" author="sddnw">
        <addColumn tableName="empire_activity">
            <column name="first_turn" type="int"/>
        </addColumn>
    </changeSet>

    <!-- Итоги галактики недели по расам (пункт 146) считаются из истории партий. -->
    <changeSet id="132-game-record-weekly" author="sddnw">
        <addColumn tableName="game_record">
            <column name="weekly_week" type="int"/>
        </addColumn>
    </changeSet>

    <!--
        Метки наставника на карте ученика (пункт 184): знак кодом, а не текстом — реплики между
        людьми в этой игре только кодами (пункт 183).
    -->
    <changeSet id="132-map-mark" author="sddnw">
        <createTable tableName="map_mark">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="game_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_map_mark_game"
                             references="game(id)" deleteCascade="true"/>
            </column>
            <column name="author_player_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="student_player_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="system_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="turn" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="map_mark" columnNames="student_player_id, system_id"
                             constraintName="uq_map_mark_student_system"/>
        <createIndex tableName="map_mark" indexName="ix_map_mark_game">
            <column name="game_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
