<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Итог по могуществу спрашивает согласия людей (09.10.2026, MightConsentService): кандидат и
        ход вопроса — у партии, ответ — у игрока.
    -->
    <changeSet id="140-might-consent" author="sddnw">
        <addColumn tableName="game">
            <column name="might_pending_player_id" type="uuid"/>
            <column name="might_pending_turn" type="integer"/>
        </addColumn>
        <addColumn tableName="player">
            <column name="might_answer" type="varchar(8)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
