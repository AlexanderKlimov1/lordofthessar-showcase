<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        13.10.2026, перенос технологий MOO II: гиперконденсаторы и скоростные ракетные стойки.
        Корабль с ними стреляет лучами (ракетами) дважды за круг, а следующий круг этим видом оружия
        молчит. Круг, в который оно молчит, помнит строка корабля на поле; пусто — не молчит.
    -->
    <changeSet id="143-double-volley" author="sddnw">
        <addColumn tableName="battle_ship">
            <column name="beams_rest_round" type="integer"/>
            <column name="missiles_rest_round" type="integer"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
