<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        13.10.2026, перенос технологий MOO II: опыт экипажей (для космической академии). Опыт — у строки
        состава флота; на поле боя корабль несёт прибавку своего звания.
    -->
    <changeSet id="148-crew-experience" author="sddnw">
        <addColumn tableName="fleet_ship">
            <column name="experience" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="battle_ship">
            <column name="crew_bonus" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
